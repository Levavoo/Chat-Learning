# AWS Configuration
AWS_PROFILE=digibro-us-dev
AWS_REGION=us-east-1

# Bedrock Configuration
BEDROCK_MODEL_ID=gpt-oss-120b

# Guardrail Agent (set to enable local guardrail classification)
GUARDRAIL_AGENT_MODEL_ID=eu.amazon.nova-lite-v1:0

# Knowledge Base Configuration
# Get this from: aws cloudformation describe-stacks --stack-name renate-etl-kb-dev --query "Stacks[0].Outputs[?contains(OutputKey,'KnowledgeBase')].OutputValue" --output text --profile digibro-us-dev
KNOWLEDGE_BASE_ID=LIQYDFWB2U
KB_RETRIEVAL_RESULTS=50
KB_RERANKER_RESULTS=30

# Content dedup (#698): collapse duplicate note/table + parent passages after fusion+rerank.
CONTENT_DEDUP_ENABLED=true
CONTENT_DEDUP_CONTAINMENT_MIN=0.80
CONTENT_DEDUP_PARENT_CONTEXT_MIN=0.50
CONTENT_DEDUP_SHINGLE_SIZE=8

# DynamoDB Configuration (optional - leave empty to disable conversation storage locally)
# DB_TABLE_NAME=test_feedback

# Brochure Priority Configuration
BROCHURE_PRIORITY_FILE=backend/data/Liste_XML_Prio_&_Authority_Boost_der_Broschueren.xlsx
