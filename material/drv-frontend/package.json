{
  "name": "drv-digi-bro-frontend-ng",
  "version": "3.39.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --watch --configuration development",
    "dev:intern": "ng serve -c dev-intern --port 4201",
    "watch": "ng build --watch --configuration development",
    "start": "NODE_ENV=development npm run start:local",
    "start:local": "ng serve -c local",
    "start:local-intern": "NODE_ENV=development ng serve -c local-intern --port 4201",
    "start:development": "ng serve",
    "start:dev-intern": "NODE_ENV=intern ng serve -c dev-intern --port 4201",
    "start:production": "ng serve -c production",
    "start:prod-intern": "NODE_ENV=production ng serve -c prod-intern",
    "start:review": "NODE_ENV=production ng serve -c review",
    "qa": "ng serve -c review",
    "prod": "ng serve -c production",
    "prod:intern": "ng serve -c prod-intern",
    "build": "NODE_ENV=production ng build",
    "build:digibro-production": "NODE_ENV=production ng build",
    "build:dev": "NODE_ENV=development ng build -c development",
    "build:dev-intern": "NODE_ENV=development ng build -c dev-intern",
    "build:dev:intern": "ng build -c dev-intern",
    "build:development": "NODE_ENV=development ng build -c development",
    "build:local": "NODE_ENV=development ng build -c local",
    "build:local-intern": "NODE_ENV=development ng build -c local-intern",
    "build:review": "NODE_ENV=production ng build -c review",
    "build:qa": "ng build -c qa",
    "build:staging": "NODE_ENV=production ng build -c production",
    "build:prod": "NODE_ENV=production ng build -c production",
    "build:prod-intern": "NODE_ENV=production ng build -c prod-intern",
    "build:prod:intern": "ng build -c prod-intern",
    "test": "NODE_ENV=test ng test",
    "test:coverage": "NODE_ENV=test ng test --code-coverage",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:e2e": "playwright test",
    "test:smoke:frontend": "bash e2e/smoke/run-smoke.sh",
    "test:smoke:browser": "playwright test --config=playwright.smoke.config.ts",
    "test:smoke:deployed": "bash e2e/smoke/run-deployed-smoke.sh",
    "test:smoke:deployed:readiness": "node e2e/smoke/wait-for-deployed-entrypoint.mjs",
    "test:smoke:deployed:browser": "playwright test --config=playwright.deployed-smoke.config.ts",
    "test:smoke:deployed:unit": "node --test e2e/smoke/wait-for-deployed-entrypoint.test.mjs",
    "test:e2e:extern": "playwright test --project=frontend-extern-firefox",
    "test:e2e:intern": "playwright test --project=frontend-intern-firefox",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen:4200": "playwright codegen http://localhost:4200/",
    "test:e2e:codegen:4201": "playwright codegen http://localhost:4201/",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:bedrock": "playwright test bedrock-integration",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint src/",
    "format": "npx prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "generate:types": "openapi-typescript ../backend/openapi.yaml -o src/app/types/api.generated.ts && npx prettier --write src/app/types/api.generated.ts",
    "postinstall": "npm run generate:types"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "^21.2.20",
    "@angular/animations": "21.2.19",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@aws-amplify/auth": "^6.13.3",
    "@drv-ds/drv-design-system-ng": "file:./vendor/drv-design-system-ng-9.9.0.tgz",
    "@ngx-env/builder": "^21.0.1",
    "@types/uuid": "^11.0.0",
    "aws-amplify": "^6.16.4",
    "dompurify": "^3.4.12",
    "marked": "^18.0.0",
    "rxjs": "~7.8.0",
    "stacktrace-js": "^2.0.2",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^21.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.2.0",
    "@angular-eslint/schematics": "^21.2.0",
    "@angular-eslint/template-parser": "^21.2.0",
    "@angular/build": "^21.2.21",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@playwright/test": "^1.59.1",
    "@types/dompurify": "^3.0.5",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/pdfjs-dist": "^2.10.378",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.26.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@smithy/config-resolver": "^4.4.0",
    "serialize-javascript": "7.0.5"
  }
}
