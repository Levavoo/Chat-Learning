   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# NumPy\n",
    "arr = np.array([1,2,3])\n",
    "print(arr*2)\n",
    "\n",
    "# pandas\n",
    "df = pd.DataFrame({\"a\":[1,2,3]})\n",
    "print(df[\"a\"])\n",
    "\n",
    "# filtering\n",
    "print(df[df[\"a\"] > 1])\n",
    "\n",
    "# groupby\n",
    "df = pd.DataFrame({\"a\":[1,1,2], \"b\":[10,20,30]})\n",
    "print(df.groupby(\"a\")[\"b\"].mean())"
   ]
  }
