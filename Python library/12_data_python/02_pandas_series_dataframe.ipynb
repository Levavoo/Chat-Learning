    "import pandas as pd\n",
    "\n",
    "# Series\n",
    "s = pd.Series([10, 20, 30])\n",
    "print(s)\n",
    "\n",
    "# DataFrame\n",
    "data = {\n",
    "    \"name\": [\"Alice\", \"Bob\"],\n",
    "    \"age\": [25, 30]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "print(df)\n",
    "\n",
    "# Access column\n",
    "print(df[\"name\"])\n",
    "\n",
    "# Access row\n",
    "print(df.iloc[0])"
   ]
  }
